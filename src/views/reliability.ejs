<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reliability · Job Hunter</title><script src="https://cdn.tailwindcss.com"></script><script>tailwind.config={theme:{extend:{colors:{ink:'#102a43',accent:'#0f766e'}}}}</script><style>body{font-family:ui-sans-serif,system-ui,sans-serif}</style></head>
<body class="min-h-screen bg-slate-100 text-ink"><%- include('partials/header') %><main class="mx-auto max-w-7xl space-y-5 px-4 py-6">
  <% if (error) { %><div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></div><% } %><% if (success) { %><div class="rounded-xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-900"><%= success %></div><% } %>
  <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-[.16em] text-accent">Local admin</p><h1 class="mt-1 text-3xl font-bold">Reliability dashboard</h1><p class="mt-2 text-sm text-slate-500">Current-build metrics exclude historical contamination, local diagnostics, and non-attempts. Safety checks remain all-history.</p><p class="mt-1 text-xs font-bold text-teal-800"><%= report.scope.mode === 'CURRENT_BUILD' ? 'Build '+report.scope.extensionVersion+' · baseline '+new Date(report.scope.baselineStartedAt).toLocaleString('en-IN') : 'Historical comparison' %></p></div><div class="flex flex-wrap gap-2"><form><label class="text-xs font-bold text-slate-500">Scope<select name="scope" onchange="this.form.submit()" class="ml-2 rounded-lg border bg-white px-3 py-2 text-sm text-ink"><option value="current" <%= report.scope.mode === 'CURRENT_BUILD' ? 'selected' : '' %>>Current build</option><option value="historical" <%= report.scope.mode === 'HISTORICAL' ? 'selected' : '' %>>Historical</option></select></label><label class="ml-2 text-xs font-bold text-slate-500">Window<select name="days" onchange="this.form.submit()" class="ml-2 rounded-lg border bg-white px-3 py-2 text-sm text-ink"><% [7,30,90].forEach(function(day){ %><option value="<%= day %>" <%= report.days === day ? 'selected' : '' %>><%= day %> days</option><% }) %></select></label></form><form method="post" action="/admin/reliability/baseline" onsubmit="return confirm('Start a fresh current-build measurement window? Historical evidence will be preserved.');"><button class="rounded-lg border border-accent bg-white px-3 py-2 text-xs font-bold text-accent">Start fresh baseline</button></form></div></div>
  <% const cards = [
    {label:'Autofill success rate',value:report.autofill.successRate == null?'—':report.autofill.successRate+'%',detail:report.autofill.filled+' of '+report.autofill.attempted+' automatic attempts · '+report.autofill.notAttempted+' not attempted'},
    {label:'Field verification rate',value:report.verification.successRate == null?'—':report.verification.successRate+'%',detail:report.verification.verified+' of '+report.verification.attempted+' attempted fields verified'},
    {label:'Fields requiring review',value:report.review.openItems,detail:report.review.blockingItems+' blocking · '+report.review.fields+' validation failures'},
    {label:'Upload failures',value:report.uploads.failures,detail:report.uploads.confirmed+' confirmed · '+report.uploads.notAttempted+' not attempted · receipt evidence'},
    {label:'Unknown mappings',value:report.mappings.unknown,detail:report.mappings.knownPatterns+' learned portal patterns'},
    {label:'Session recovery rate',value:report.sessions.recoveryRate == null?'—':report.sessions.recoveryRate+'%',detail:report.sessions.recovered+' of '+report.sessions.multiPageSessions+' multi-page sessions ready'},
    {label:'Learned mapping success',value:report.mappings.successRate == null?'—':report.mappings.successRate+'%',detail:report.mappings.succeeded+' succeeded · '+report.mappings.failed+' failed'},
    {label:'AI calls',value:report.ai.calls,detail:report.ai.failedCalls+' failed · '+(report.ai.inputTokens+report.ai.outputTokens).toLocaleString('en-IN')+' tokens'},
    {label:'Estimated AI cost',value:'$'+report.ai.estimatedCostUsd.toFixed(4),detail:(report.ai.unpricedCalls ? report.ai.unpricedCalls+' call(s) use an unpriced model · ' : '')+'Token estimate; not an invoice'}
  ]; %>
  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><% cards.forEach(function(card){ %><article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-bold uppercase tracking-wide text-slate-500"><%= card.label %></p><strong class="mt-2 block text-3xl text-accent"><%= card.value %></strong><p class="mt-2 text-xs leading-5 text-slate-500"><%= card.detail %></p></article><% }) %></section>
  <section class="grid gap-4 lg:grid-cols-2"><article class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-lg font-bold">How to read this</h2><dl class="mt-4 grid gap-3 text-sm"><div><dt class="font-bold">Autofill</dt><dd class="text-slate-500">A field counts as successful only when evidence records it as FILLED. Protected and declaration controls are excluded in the current build.</dd></div><div><dt class="font-bold">Learning</dt><dd class="text-slate-500">Only verified completion or explicit save may finalize reusable memory. Application opt-out and protected-value gates apply first.</dd></div><div><dt class="font-bold">Session recovery</dt><dd class="text-slate-500">Multi-page application attempts that reached ready-to-submit or verified success.</dd></div><div><dt class="font-bold">Mappings</dt><dd class="text-slate-500">Outcomes from replaying learned structural selectors. Candidate values are not stored in this metric.</dd></div></dl></article>
  <article class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-lg font-bold">Release signals</h2><div class="mt-4 grid gap-2 text-sm"><div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Upload reliability</span><strong><%= report.uploads.successRate == null ? 'Needs samples' : report.uploads.successRate+'%' %></strong></div><div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Unresolved blockers</span><strong><%= report.review.blockingItems %></strong></div><div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Mapping samples</span><strong><%= report.mappings.succeeded + report.mappings.failed %></strong></div><div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Generated</span><strong><%= new Date(report.generatedAt).toLocaleString('en-IN') %></strong></div></div></article></section>
  <% if (report.byPortal.length) { %><section class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-lg font-bold">Current scope by portal</h2><div class="mt-4 grid gap-3 md:grid-cols-2 lg:grid-cols-3"><% report.byPortal.forEach(function(portal){ %><article class="rounded-xl bg-slate-50 p-4"><strong class="capitalize"><%= portal.portalKind %></strong><p class="mt-2 text-xs text-slate-600">Verified: <b><%= portal.verificationRate == null ? '—' : portal.verificationRate+'%' %></b> · Mapped: <b><%= portal.mappingRate == null ? '—' : portal.mappingRate+'%' %></b> · Upload: <b><%= portal.uploadRate == null ? '—' : portal.uploadRate+'%' %></b></p><p class="mt-1 text-xs text-slate-500"><%= portal.attemptedFields %> attempted · <%= portal.notAttemptedFields %> not attempted · <%= portal.uploadReceipts %> upload receipt(s)</p></article><% }) %></div></section><% } %>
  <div class="flex flex-wrap gap-2"><a href="/api/admin/reliability?days=<%= report.days %>&scope=<%= report.scope.mode === 'HISTORICAL' ? 'historical' : 'current' %>" class="rounded-lg border border-accent px-4 py-2 text-sm font-bold text-accent">View JSON</a><a href="/attention" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold">Open Attention Center</a></div>
</main></body></html>
