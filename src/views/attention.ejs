<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Attention Center · Job Hunter</title>
<style>
:root{color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#102a43;font:15px system-ui,-apple-system,sans-serif}.wrap{max-width:960px;margin:auto;padding:32px 20px 56px}a{color:#315ee7}.top{display:flex;justify-content:space-between;align-items:start;gap:20px}.eyebrow{color:#315ee7;font-size:12px;font-weight:900;letter-spacing:.09em}.top h1{font-size:34px;margin:8px 0}.top p{max-width:620px;color:#52647a;line-height:1.55}.count{white-space:nowrap;background:#fff1f2;color:#be123c;border-radius:999px;padding:8px 13px;font-weight:850}.window{display:inline-flex;margin:22px 0 16px;padding:7px 11px;border:1px solid #dbe3ef;background:#fff;border-radius:999px;color:#52647a;font-size:13px}.cards{display:grid;gap:14px}.card{background:#fff;border:1px solid #dbe3ef;border-radius:18px;padding:18px;box-shadow:0 10px 30px #0f172a0a}.card-head{display:flex;justify-content:space-between;gap:12px}.title{font-size:19px;font-weight:850}.company{margin-top:3px;color:#64748b}.badge{height:max-content;border-radius:999px;padding:5px 9px;background:#ecfdf5;color:#047857;font-size:11px;font-weight:850}.badge.needs{background:#fff7ed;color:#c2410c}.meta{display:flex;flex-wrap:wrap;gap:7px;margin:13px 0}.meta span{padding:5px 8px;border-radius:999px;background:#f1f5f9;color:#52647a;font-size:12px}.meta span.platform-tag{background:#0f172a;color:#fff;font-weight:800}.meta span.support-tag{background:#fef3c7;color:#92400e;font-weight:800}.items{margin:14px 0 0;padding:0;list-style:none;display:grid;gap:8px}.item{display:grid;grid-template-columns:24px 1fr;gap:8px;padding:10px;background:#fffbeb;border-radius:10px}.mark{width:22px;height:22px;display:grid;place-items:center;border-radius:50%;background:#fef3c7;color:#c2410c;font-weight:900}.item strong,.item small{display:block}.item small{margin-top:2px;color:#6b7280}.action{display:inline-block;margin-top:14px;background:#315ee7;color:#fff;text-decoration:none;border-radius:10px;padding:9px 13px;font-weight:800}.empty{padding:52px 24px;text-align:center;background:#fff;border:1px solid #dbe3ef;border-radius:18px;color:#64748b}.empty strong{display:block;color:#102a43;font-size:19px;margin-bottom:6px}.notice{padding:12px 14px;border-radius:12px;background:#ecfdf5;color:#047857;margin:18px 0}@media(max-width:620px){.top{display:block}.count{display:inline-block}.top h1{font-size:28px}}
</style></head><body><main class="wrap">
<div class="top"><div><a href="/copilot">← Applications</a><div class="eyebrow">JOB HUNTER COPILOT</div><h1>Attention Center</h1><p>One place for every recent application that still needs a fact, review, upload, or manual action. Reopen an application to continue its saved session.</p></div><span class="count"><%= blockingCount %> need you</span></div>
<% if (notice) { %><div class="notice"><%= notice %></div><% } %>
<div class="window">Showing application sessions from the last 3 days</div>
<section class="cards" aria-label="Recent application sessions">
<% if (!sessions.length) { %><div class="empty"><strong>You’re all caught up.</strong>Recent applications that need your help will appear here as a single session.</div><% } %>
<% sessions.forEach(function(session){ %><article class="card">
  <div class="card-head"><div><div class="title"><%= session.role %></div><div class="company"><%= session.company || 'Company' %></div></div><span class="badge <%= session.attentionCount ? 'needs' : '' %>"><%= session.attentionCount ? session.attentionCount + ' to review' : 'No action needed' %></span></div>
  <div class="meta"><span><%= session.applicationStatus.replaceAll('_',' ') %></span><% if (session.platform) { %><span class="platform-tag"><%= session.platform.label %></span><% } %><% if (session.applySupport) { %><span class="support-tag"><%= session.applySupport.label %></span><% } %><span>Started <%= new Date(session.startedAt + 'Z').toLocaleString('en-IN', {dateStyle:'medium',timeStyle:'short'}) %></span><span>Review-only submit</span></div>
  <% if (session.items.length) { %><ul class="items"><% session.items.slice(0,4).forEach(function(item){ %><li class="item"><span class="mark">!</span><div><strong><%= item.title %></strong><small><%= item.reason %></small></div></li><% }) %></ul><% } %>
  <% if (session.items.some(function(item){ return item.type === 'SUBMISSION_REVIEW'; })) { %><form method="post" action="/attention/applications/<%= session.applicationId %>/mark-submitted" onsubmit="return confirm('Confirm that the employer received this application?');"><button class="action" type="submit">Mark submitted</button></form><% } %>
  <% if (session.currentUrl) { %><a class="action" href="<%= session.currentUrl %>"><%= session.attentionCount ? 'Continue application' : 'Reopen application' %></a><% } %>
</article><% }) %>
</section></main></body></html>
