<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Adapters · Job Hunter</title><script src="https://cdn.tailwindcss.com"></script><script>tailwind.config={theme:{extend:{colors:{ink:'#102a43',accent:'#0f766e'}}}}</script><style>body{font-family:ui-sans-serif,system-ui,sans-serif}</style></head>
<body class="min-h-screen bg-slate-100 text-ink"><%- include('partials/header') %><main class="mx-auto max-w-7xl space-y-5 px-4 py-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-[.16em] text-accent">Local ops</p>
      <h1 class="mt-1 text-3xl font-bold">Adapter health</h1>
      <p class="mt-2 text-sm text-slate-500">Hostname → portal adapter → mapping pack. Kill switches pause fill without rewriting the content script. Learned patches stay scoped and never auto-edit <code>content.js</code>.</p>
    </div>
    <a href="/api/admin/adapters" class="rounded-lg border border-accent px-4 py-2 text-sm font-bold text-accent">View JSON</a>
  </div>
  <% if (success) { %><p class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900"><%= success %></p><% } %>
  <% if (error) { %><p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p><% } %>

  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% (report.portals || []).forEach(function(portal){ %>
      <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-500"><%= portal.label %></p>
          <span class="rounded-full px-2 py-0.5 text-[10px] font-bold <%= portal.killed ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800' %>"><%= portal.killed ? 'KILLED' : portal.mappingStage %></span>
        </div>
        <strong class="mt-2 block text-3xl text-accent"><%= portal.fillRate == null ? '—' : portal.fillRate + '%' %></strong>
        <p class="mt-2 text-xs leading-5 text-slate-500"><%= portal.filled %> filled · <%= portal.failed %> failed · v<%= portal.mappingPackVersion %></p>
        <form method="post" action="/admin/adapters/<%= portal.id %>/<%= portal.killed ? 'revive' : 'kill' %>" class="mt-3">
          <button class="rounded-lg border px-3 py-1.5 text-xs font-bold <%= portal.killed ? 'border-accent text-accent' : 'border-red-300 text-red-800' %>"><%= portal.killed ? 'Revive adapter' : 'Kill switch' %></button>
        </form>
      </article>
    <% }) %>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <article class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-bold">Mapping packs</h2>
      <p class="mt-1 text-sm text-slate-500">LOCAL_DRAFT → SHADOW → CANARY → DEFAULT. SHADOW → CANARY requires Form A <strong>PASS</strong> for that ATS (resume and cover letter stay on distinct controls). CANARY is the first stage that can override DEFAULT.</p>
      <% var formA = report.formAGate || {}; %>
      <p class="mt-2 rounded-lg px-3 py-2 text-xs font-semibold <%= formA.status === 'PASS' ? 'bg-emerald-50 text-emerald-900' : 'bg-red-50 text-red-800' %>">
        Form A <%= formA.status || 'UNKNOWN' %><% if (formA.reason) { %> · <%= formA.reason %><% } %>
      </p>
      <div class="mt-4 space-y-2 text-sm">
        <% (report.packs || []).slice(0, 12).forEach(function(pack){ %>
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 p-3">
            <div><strong><%= pack.portalKind %></strong> · v<%= pack.version %> · <%= pack.stage %></div>
            <% if (pack.stage !== 'DEFAULT' && pack.stage !== 'KILLED') { %>
              <form method="post" action="/admin/mapping-packs/<%= pack.id %>/promote"><button class="text-xs font-bold text-accent">Promote</button></form>
            <% } %>
          </div>
        <% }) %>
      </div>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-bold">Learn proposals</h2>
      <p class="mt-1 text-sm text-slate-500">Clustered fill failures. Promoting writes a host-scoped pack, not a live content-script patch.</p>
      <div class="mt-4 space-y-2 text-sm">
        <% if (!(report.proposals || []).length) { %><p class="text-slate-500">No clustered failures yet.</p><% } %>
        <% (report.proposals || []).slice(0, 8).forEach(function(proposal){ %>
          <div class="rounded-lg bg-slate-50 p-3">
            <div class="flex justify-between gap-2"><strong><%= proposal.portalKind %></strong><span><%= proposal.occurrenceCount %>× · <%= proposal.status %></span></div>
            <p class="mt-1 text-xs text-slate-500"><%= proposal.controlKind %> · <%= proposal.fingerprint %> · Form A <%= proposal.formAGate %><% if (proposal.formAGate === 'FAIL') { %> (blocked)<% } %></p>
            <% if (proposal.promoteBlockedReason) { %>
              <p class="mt-2 text-xs font-semibold text-slate-500">Cannot promote · <%= String(proposal.promoteBlockedReason).replaceAll('_', ' ').toLowerCase() %></p>
            <% } %>
            <% if (proposal.status === 'PROPOSED') { %>
              <div class="mt-2 flex gap-2">
                <% if (!proposal.promoteBlockedReason) { %>
                  <form method="post" action="/admin/proposals/<%= proposal.id %>/promote"><button class="text-xs font-bold text-accent">Save as LOCAL_DRAFT</button></form>
                <% } %>
                <form method="post" action="/admin/proposals/<%= proposal.id %>/dismiss"><button class="text-xs font-bold text-slate-500">Dismiss</button></form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </article>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <article class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-bold">Flags</h2>
      <form method="post" action="/admin/flags" class="mt-3 grid gap-2 sm:grid-cols-3">
        <input name="key" placeholder="flag.key" class="rounded-lg border px-3 py-2 text-sm" required>
        <select name="enabled" class="rounded-lg border px-3 py-2 text-sm"><option value="1">On</option><option value="0">Off</option></select>
        <button class="rounded-lg bg-accent px-3 py-2 text-sm font-bold text-white">Save flag</button>
      </form>
      <div class="mt-4 space-y-2 text-sm">
        <% (report.flags || []).forEach(function(flag){ %>
          <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span><%= flag.key %></span><strong><%= flag.enabled ? 'on' : 'off' %></strong></div>
        <% }) %>
        <% if (!(report.flags || []).length) { %><p class="text-slate-500">No flags set.</p><% } %>
      </div>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-bold">Local entitlements</h2>
      <p class="mt-1 text-sm text-slate-500"><%= report.entitlements.note %></p>
      <div class="mt-4 grid gap-2 text-sm">
        <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Plan</span><strong><%= report.entitlements.plan %></strong></div>
        <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Adapter fills (30d)</span><strong><%= report.usage.meters.ADAPTER_FILL.events %></strong></div>
        <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>AI token events</span><strong><%= report.usage.meters.AI_TOKENS.events %></strong></div>
      </div>
    </article>
  </section>

  <article class="rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-bold">Learning hygiene</h2>
    <p class="mt-1 text-sm text-slate-500">Patterns without a structural selector, and clusters with no reusable meaning, are removed instead of being learned.</p>
    <div class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
      <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Empty-selector patterns removed</span><strong><%= (report.learningHygiene || {}).removedEmptySelectors || 0 %></strong></div>
      <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>CUSTOM_FIELD noise removed</span><strong><%= (report.learningHygiene || {}).removedCustomFieldNoise || 0 %></strong></div>
      <div class="flex justify-between rounded-lg bg-slate-50 p-3"><span>Noisy proposals retired</span><strong><%= (report.learningHygiene || {}).rejected || 0 %></strong></div>
    </div>
    <% var skipped = ((report.learningHygiene || {}).skippedClusters || []); %>
    <% if (!skipped.length) { %><p class="mt-3 text-sm text-slate-500">No failure clusters were skipped.</p><% } %>
    <div class="mt-3 space-y-2 text-sm">
      <% skipped.slice(0, 8).forEach(function(cluster){ %>
        <div class="flex flex-wrap justify-between gap-2 rounded-lg bg-slate-50 p-3">
          <span><%= cluster.portalKind %> · <%= cluster.fieldLabel || 'unlabelled field' %></span>
          <strong><%= cluster.occurrences %>× · <%= String(cluster.skipReason).replaceAll('_', ' ').toLowerCase() %></strong>
        </div>
      <% }) %>
    </div>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-bold">Redacted incidents</h2>
    <% if (!(report.incidents || []).length) { %><p class="mt-3 text-sm text-slate-500">No adapter incidents recorded.</p><% } %>
    <div class="mt-3 space-y-2 text-sm">
      <% (report.incidents || []).forEach(function(incident){ %>
        <div class="flex flex-wrap justify-between gap-2 rounded-lg bg-slate-50 p-3">
          <span><%= incident.portalKind %> · <%= incident.failureClass %> · <%= incident.controlKind || 'control' %></span>
          <strong><%= incident.occurrenceCount %>×</strong>
        </div>
      <% }) %>
    </div>
  </article>
</main></body></html>
