<!doctype html>
<html lang="en">
<%- include('partials/header', { panel, counts }) %>
<main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6">
  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-accent">Phase 0F · local admin</p>
        <h1 class="mt-1 text-3xl font-bold text-ink">Adaptive evidence</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-500">Value-free classifier evidence is weighted independently by layer. Every result on this page is SHADOW-only: it cannot change candidate truth, mappings, representations, strategies, declarations, or application behavior.</p>
      </div>
      <form method="post" action="/admin/adaptive-evidence/shadow">
        <input type="hidden" name="enabled" value="<%= adaptive.enabled ? 'false' : 'true' %>">
        <button class="rounded-xl border px-4 py-2 text-sm font-bold <%= adaptive.enabled ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-accent bg-accent text-white' %>"><%= adaptive.enabled ? 'Pause SHADOW recording' : 'Enable SHADOW recording' %></button>
      </form>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-4">
      <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs font-bold uppercase text-slate-500">Classifier</p><p class="mt-1 font-bold"><%= classifier.enabled ? 'SHADOW enabled' : 'Off' %></p></div>
      <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs font-bold uppercase text-slate-500">Evidence router</p><p class="mt-1 font-bold"><%= adaptive.enabled ? 'SHADOW enabled' : 'Off' %></p></div>
      <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs font-bold uppercase text-slate-500">Events</p><p class="mt-1 text-2xl font-bold"><%= report.totals.events %></p></div>
      <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs font-bold uppercase text-slate-500">Runs</p><p class="mt-1 text-2xl font-bold"><%= report.totals.runs %></p></div>
    </div>
  </section>

  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% if (!report.counts.length) { %><div class="rounded-2xl border border-dashed border-slate-300 bg-white p-5 text-sm text-slate-500">No SHADOW rollups yet. Enable recording and complete an application checkpoint.</div><% } %>
    <% report.counts.forEach(function(item){ %>
      <div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-xs font-bold uppercase tracking-wide text-slate-500"><%= item.state.replaceAll('_', ' ') %></p><p class="mt-2 text-3xl font-bold"><%= item.count %></p></div>
    <% }) %>
  </section>

  <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-5"><h2 class="text-lg font-bold">Reproducible SHADOW decisions</h2><p class="mt-1 text-sm text-slate-500">Recent evidence decays; lifetime evidence remains intact. Direct and rescue strategy populations remain separate.</p></div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Layer / subject</th><th class="px-4 py-3">State</th><th class="px-4 py-3">Lifetime + / −</th><th class="px-4 py-3">Recent + / −</th><th class="px-4 py-3">Independent evidence</th><th class="px-4 py-3">Reasons</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% report.rollups.forEach(function(row){ %><tr>
            <td class="px-4 py-3"><strong><%= row.layer.replaceAll('_', ' ') %></strong><div class="mt-1 max-w-xs truncate text-xs text-slate-500"><%= row.subject_key %> · <%= row.execution_context.replaceAll('_', ' ') %></div></td>
            <td class="px-4 py-3"><span class="rounded-full px-2 py-1 text-xs font-bold <%= row.volatile ? 'bg-red-100 text-red-800' : row.state.includes('PROMOTION') ? 'bg-emerald-100 text-emerald-800' : row.state.includes('DEGRADE') || row.state.includes('QUARANTINE') ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-700' %>"><%= row.state.replaceAll('_', ' ') %></span></td>
            <td class="px-4 py-3 font-mono"><%= row.lifetime_positive %> / <%= row.lifetime_negative %></td>
            <td class="px-4 py-3 font-mono"><%= row.recent_positive %> / <%= row.recent_negative %></td>
            <td class="px-4 py-3 text-xs"><%= row.independent_candidate_count %> users · <%= row.independent_run_count %> runs · <%= row.independent_form_count %> forms</td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= (row.decision.reasonCodes || []).join(' · ') %></td>
          </tr><% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <a class="inline-flex rounded-xl border border-accent px-4 py-2 text-sm font-bold text-accent" href="/api/admin/adaptive-evidence">View JSON</a>
</main>
</body></html>
