<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Application outcomes · Job Hunter</title>
<style>
:root{color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#102a43;font:15px system-ui,-apple-system,sans-serif}.wrap{max-width:980px;margin:auto;padding:32px 20px 56px}a{color:#315ee7}.head{display:flex;justify-content:space-between;gap:20px;align-items:start}.head h1{margin:8px 0;font-size:34px}.head p{color:#52647a;max-width:650px;line-height:1.55}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0}.metric,.card{background:#fff;border:1px solid #dbe3ef;border-radius:16px;padding:17px}.metric strong{display:block;font-size:27px}.metric span{color:#64748b;font-size:12px}.notice,.error{padding:11px 14px;border-radius:10px;margin:14px 0}.notice{background:#ecfdf5;color:#047857}.error{background:#fff1f2;color:#be123c}.events{display:grid;gap:10px}.event{display:grid;grid-template-columns:1fr auto;gap:14px}.event h3{margin:0}.event p{margin:5px 0;color:#64748b}.badge{padding:5px 9px;height:max-content;border-radius:999px;background:#eef2ff;color:#315ee7;font-size:11px;font-weight:800}.proposed{background:#fff7ed;color:#c2410c}.actions{display:flex;gap:7px;margin-top:10px}.actions button{border:1px solid #cbd5e1;background:#fff;border-radius:8px;padding:7px 10px;font-weight:700;cursor:pointer}.empty{text-align:center;color:#64748b}.coverage{margin:0 0 20px;color:#52647a;font-size:13px}@media(max-width:650px){.metrics{grid-template-columns:1fr}.head{display:block}.event{grid-template-columns:1fr}}
</style></head><body><main class="wrap">
<div class="head"><div><a href="/copilot">← Applications</a><h1>Application outcomes</h1><p>Track what happened after submission. Candidate-confirmed events are authoritative; email and calendar detections remain proposals until you review them.</p></div><a href="/attention">Attention Center</a></div>
<% if (notice) { %><div class="notice"><%= notice %></div><% } %><% if (error) { %><div class="error"><%= error %></div><% } %>
<section class="metrics"><div class="metric"><strong><%= report.submittedApplications %></strong><span>submitted applications</span></div><div class="metric"><strong><%= report.applicationsWithKnownOutcome %></strong><span>with a confirmed outcome</span></div><div class="metric"><strong><%= report.coveragePercent %>%</strong><span>known-outcome coverage</span></div></section>
<p class="coverage">Always interpret response and interview rates together with this coverage percentage. Unknown is not treated as rejected.</p>
<section class="events"><% if (!report.events.length) { %><div class="card empty">No outcome updates yet. Record updates from an application card as recruiters respond.</div><% } %>
<% report.events.forEach(function(event){ %><article class="card event"><div><h3><%= event.title %> · <%= event.company_name || 'Company' %></h3><p><strong><%= event.event_type.replaceAll('_',' ') %></strong> · <%= new Date(event.occurred_at).toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short'}) %> · source: <%= event.evidence_source %></p><% if(event.note){ %><p><%= event.note %></p><% } %>
<% if(event.confirmation_status === 'PROPOSED'){ %><div class="actions"><form method="post" action="/outcomes/<%= event.id %>/confirm"><input type="hidden" name="confirmed" value="true"><button>Confirm</button></form><form method="post" action="/outcomes/<%= event.id %>/confirm"><input type="hidden" name="confirmed" value="false"><button>Not this application</button></form></div><% } %></div><span class="badge <%= event.confirmation_status === 'PROPOSED' ? 'proposed' : '' %>"><%= event.confirmation_status %></span></article><% }) %></section>
</main></body></html>
