{
  "portalKind": "generic",
  "version": 1,
  "stage": "DEFAULT",
  "hotPath": {
    "identityOnly": true,
    "skipLlmOn": [
      "FIRST_NAME",
      "LAST_NAME",
      "FULL_NAME",
      "EMAIL",
      "PHONE",
      "RESUME",
      "COVER_LETTER"
    ]
  },
  "skipSelectors": [],
  "fileFields": {
    "resume": {
      "testIds": [
        "input-resume"
      ],
      "labelPatterns": [
        "resume",
        "curriculum",
        "cv"
      ]
    },
    "coverLetter": {
      "testIds": [
        "input-cover_letter"
      ],
      "labelPatterns": [
        "cover letter"
      ]
    }
  },
  "neverFill": [
    "password",
    "otp",
    "captcha",
    "legal",
    "consent"
  ],
  "controlKindAliases": {
    "radiogroup": "choice-group",
    "likert": "choice-group"
  },
  "overlays": {
    "embeddedFrameSelector": "#grnhse_iframe, iframe[src*='greenhouse.io'], iframe[src*='job_app'], iframe[src*='lever.co'], iframe[src*='ashbyhq.com']",
    "formContainers": "form, [role=\"dialog\"], #application_form, #grnhse_app",
    "preferTestIdForUploads": true
  }
}
