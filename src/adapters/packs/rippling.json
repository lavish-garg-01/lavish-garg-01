{
  "portalKind": "rippling",
  "version": 1,
  "stage": "DEFAULT",
  "hotPath": {
    "identityOnly": true,
    "skipLlmOn": ["FIRST_NAME", "LAST_NAME", "FULL_NAME", "EMAIL", "PHONE", "RESUME", "COVER_LETTER"]
  },
  "skipSelectors": [
    "[aria-label='Search country']",
    "input[placeholder='Search country']"
  ],
  "fileFields": {
    "resume": { "testIds": ["input-resume"], "labelPatterns": ["resume", "curriculum", "cv"] },
    "coverLetter": { "testIds": ["input-cover_letter"], "labelPatterns": ["cover letter"] }
  },
  "neverFill": ["password", "otp", "captcha", "legal", "consent"],
  "controlKindAliases": {
    "radiogroup": "choice-group",
    "likert": "choice-group"
  },
  "overlays": {
    "skipGenericCurrentQuestion": true,
    "preferTestIdForUploads": true,
    "stableIdPrefersLabelForChoiceGroup": true
  }
}
