NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
# Local admin workspace: http://127.0.0.1:3000/#admin
# Set both. No Supabase/OIDC needed for this separate local admin login.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
# Run npm run db:migrate and restart the API after setting these.
# Optional local-only login. The API refuses this outside development or on a non-loopback host.
ENABLE_DEV_AUTH=false
ENABLE_OPERATOR_REVIEW=false
## Separate logins provisioned using database/security/review-service-roles.sql; NEVER the database owner.
# OPERATOR_DATABASE_URL=postgresql://review_api_login:REPLACE@127.0.0.1:5432/job_hunter_v2
# REVIEW_EVALUATOR_DATABASE_URL=postgresql://review_evaluator_login:REPLACE@127.0.0.1:5432/job_hunter_v2
ENABLE_OPERATOR_PRIVATE_REVIEW=false
ENABLE_REVIEWED_EXPORTS=false
# DEV_AUTH_TOKEN=replace-with-at-least-16-local-characters
# DEV_AUTH_EMAIL=developer@jobhunter.local
# DATABASE_URL=postgresql://user:password@localhost:5432/job_hunter_v2
# Optional filesystem storage for immutable public job-source evidence fetched by jobs:sync-live.
# JOB_RAW_EVIDENCE_ROOT=.local-data/job-evidence
# OIDC_PROVIDER=SUPABASE
# OIDC_ISSUER=https://your-project.supabase.co/auth/v1
# OIDC_AUDIENCE=authenticated
# OIDC_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# CANDIDATE_VALUE_HMAC_SECRET=replace-with-at-least-32-random-characters
# CANDIDATE_VALUE_HMAC_KEY_VERSION=1
# Optional, verification-only old keys; at most four. Use your secret manager, never commit real values.
# CANDIDATE_VALUE_HMAC_PREVIOUS_KEYS=[{"keyVersion":1,"secret":"previous-secret-at-least-32-bytes"}]
# History versions must be below the active version; read docs/LEARNING_KEY_ROTATION.md before rotating.
# RESUME_PROPOSAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# RESUME_STORAGE_ROOT=.data/private-resumes
# In development, localhost and 127.0.0.1 aliases for this same port are both accepted.
# WEB_ORIGIN=http://localhost:3000

# Phase P: server-only routes. No provider is enabled until all its settings exist.
# Use the requested owner account for provisioning; never place keys in VITE_*.
# Repeat this block with GEMINI or OPENAI in place of GROQ.
# AI_GROQ_API_KEY=
# AI_GROQ_MODEL=<provider-supported-model-id>
# AI_GROQ_MAX_INPUT_TOKENS=<validated-context-limit>
# AI_GROQ_INPUT_MICROS_PER_TOKEN=<conservative-USD-millionths-per-input-token>
# AI_GROQ_OUTPUT_MICROS_PER_TOKEN=<conservative-USD-millionths-per-output-token>
# AI_GROQ_JSON_MODE=STRICT_SCHEMA
# For Groq Llama JSON-mode models use JSON_OBJECT; local schemas always validate.
# AI_GROQ_ALLOW_PRIVATE=false
# AI_RESUME_ENABLED=false
# AI_DOCUMENT_GENERATION_ENABLED=false
# AI_DAILY_MICROS=1000000
# Run npm run db:migrate before enabling any route. Daily reservations are durable.
# Phase Q: run migrations through 0020 before startup. False opts out of Q.
# Candidate rollout separately requires independent validation and reviewer approval.
STRATEGY_INTELLIGENCE_ENABLED=true
