VITE_API_URL=http://127.0.0.1:3100
# Optional local-only login. Vite also requires its built-in DEV mode.
VITE_ENABLE_DEV_AUTH=false
VITE_DEV_AUTH_TOKEN=replace-with-the-same-local-token-as-the-api
VITE_DEV_AUTH_EMAIL=developer@jobhunter.local
# Production Chrome Web Store URL. Leave empty locally and load apps/extension/dist as unpacked.
VITE_EXTENSION_INSTALL_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anonymous-key
