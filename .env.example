PORT=3001
HOST=127.0.0.1
APP_MODE=local
# Exact browser origins allowed to call the local API. Never use * here.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional exact chrome-extension:// origins for packaged builds.
EXTENSION_ORIGINS=
APPLICATION_SCHEMA_FRESH_DAYS=3
APPLICATION_SCHEMA_EXPIRY_DAYS=7
MATCH_THRESHOLD=80
CLOSE_MIN_SCORE=70
PREFILTER_MIN_SCORE=40

# 0 = do not filter by notice period (still extracted for UI tags)
CANDIDATE_NOTICE_DAYS=0
CANDIDATE_EMAIL=your-email@example.com

# Ingestion quality gates
MAX_JOB_AGE_DAYS=14
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# OpenAI
# AI calls require BOTH this global switch and candidate consent in COPILOT Profile.
# Keep disabled until you understand and accept the data-processing boundary.
AI_PROCESSING_ENABLED=false
# Required after AI processing is enabled: OPENAI_API_KEY=your-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared, value-free field understanding. Available to Free and Paid users;
# these switches never enable candidate-specific answer generation.
CANONICAL_SEMANTIC_SEARCH_ENABLED=true
CANONICAL_EMBEDDINGS_ENABLED=false
CANONICAL_AI_ENABLED=false
CANONICAL_NEW_PROPOSALS_ENABLED=true
CANONICAL_AI_DAILY_LIMIT=200

# Hunter Domain Search. Use one authorized key per distinct application user.
# Keys are selected round-robin; a 429 quota response fails over to the next key.
HUNTER_API_KEYS=
# Example format: HUNTER_API_KEYS=authorized-user-1-key,authorized-user-2-key
# Backward-compatible single-user option: HUNTER_API_KEY=hunter-key
# Maximum recruiter emails revealed per approval; keep low to conserve credits.
HUNTER_RECRUITER_LIMIT=2

# Greenhouse / Lever / Ashby — blank Greenhouse uses built-in default (postman)
GREENHOUSE_BOARDS=postman
LEVER_COMPANIES=
ASHBY_BOARDS=

# Firecrawl — structured scrape of listing/search pages
# Signup: https://www.firecrawl.dev/signin
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_MAX_JOBS=40
# Hobby plans are ~15 req/min. Collectors share one limiter and wait on HTTP 429.
FIRECRAWL_MIN_INTERVAL_MS=4500
FIRECRAWL_MAX_RETRIES=2
# Optional comma-separated career/search listing URLs
FIRECRAWL_URLS=

# India aggregators via Firecrawl (requires FIRECRAWL_API_KEY; never mocks)
NAUKRI_ENABLED=false
INSTAHYRE_ENABLED=false
HIRIST_ENABLED=false
CUTSHORT_ENABLED=false
WELLFOUND_ENABLED=false

# JobSpy — primary channel for LinkedIn India + Indeed India
# Setup: curl -LsSf https://astral.sh/uv/install.sh | sh
#        uv venv --python 3.12 .venv && uv pip install -r requirements.txt
JOBSPY_ENABLED=false
JOBSPY_COUNTRY=india
JOBSPY_COMMAND=./.venv/bin/python scripts/jobspy_cli.py --site linkedin,indeed --search_term "backend engineer" --results_wanted 25 --country india

# Search preferences used by AI scoring context (India hubs, priority order)
TARGET_TITLES=Backend Engineer,Node.js Engineer,Software Engineer
TARGET_LOCATIONS=Remote,Gurugram,Delhi,Noida,Pune,Hyderabad,Bengaluru

# Local COPILOT application preparation. This only opens/fills a real employer form.
# Submission always remains manual under the review-only policy.
ALLOW_REAL_APPLICATION_PREPARATION=false
MAX_REAL_APPLICATIONS_PER_DAY=5
PLAYWRIGHT_HEADLESS=false
AGENT_WORKER_POLL_MS=2000
# Optional test/advanced overrides:
# DATABASE_PATH=/absolute/path/to/jobs.db
# STORAGE_PATH=/absolute/path/to/private-storage
